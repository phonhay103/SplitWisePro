# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---- Analytics (PostHog) ----
# All settings live in src/config.ts with a built-in default project key, so
# analytics works out of the box. These env vars are OPTIONAL per-deployment
# overrides (e.g. staging vs production, or one PostHog project per app).
# VITE_ANALYTICS_APP_ID: unique id for THIS app. Required for multi-app setups
# sharing one PostHog project (events are tagged with app_id) and used to
# namespace the opt-out flag (swp_analytics_optout_<appId>) so sibling apps
# never conflict. Example: splitwisepro, expensetracker, ...
VITE_ANALYTICS_APP_ID="splitwisepro"

# VITE_PUBLIC_POSTHOG_KEY: override the built-in default project API key.
# VITE_PUBLIC_POSTHOG_KEY="phc_..."

# VITE_PUBLIC_POSTHOG_HOST: override the built-in default host.
# VITE_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
